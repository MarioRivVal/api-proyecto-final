# Copiar a .env. La API no arranca si falta alguna obligatoria (src/config/env.validation.ts).

NODE_ENV=development
PORT=3200

# PostgreSQL de docker-compose.yml
DB_HOST=localhost
DB_PORT=5452
DB_USER=fortenow
DB_PASS=fortenow_pass
DB_NAME=fortenow_db

# Saltos de proxy delante de la API (Coolify = 1)
TRUST_PROXY_HOPS=1

# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Contraseñas que pone el seed a los usuarios del CSV
SEED_ATHLETE_PASSWORD=
SEED_ADMIN_PASSWORD=
